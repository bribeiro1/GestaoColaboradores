<?xml version="1.0" encoding="utf-8"?>
<!--
  Fontes de pacote fixadas no proprio repositorio.

  POR QUE ISSO EXISTE:
  O NuGet le a configuracao em cascata - a do repositorio herda a da maquina
  e a global. Sem este arquivo, o restore depende de quais feeds a maquina do
  desenvolvedor tem configurados: um feed corporativo privado presente na
  maquina de quem escreveu o codigo faz o build falhar com 401 na maquina de
  quem so quer rodar o projeto. O <clear /> zera a heranca e deixa apenas
  nuget.org, tornando o restore reproduzivel em qualquer maquina e no
  agente de CI.

  Como efeito colateral, resolve o aviso NU1507: com Central Package
  Management, multiplas fontes sem package source mapping sao ambiguas -
  o mesmo nome de pacote poderia vir de origens diferentes, que e o vetor
  do ataque de dependency confusion.
-->
<configuration>

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
