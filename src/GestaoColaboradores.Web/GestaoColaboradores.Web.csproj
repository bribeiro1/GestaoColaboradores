<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>GestaoColaboradores.Web</RootNamespace>
    <UserSecretsId>gestao-colaboradores-web</UserSecretsId>

    <!-- O .NET 10 le os comentarios XML (/// <summary>) e os injeta no
         documento OpenAPI. Com isso a descricao de cada endpoint aparece no
         Scalar sem nenhuma duplicacao: a mesma frase serve a quem le o codigo
         e a quem consome a API.
         NoWarn 1591 desliga o aviso de "membro publico sem comentario XML" -
         documentar todo tipo publico nao e o objetivo aqui. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GestaoColaboradores.Application\GestaoColaboradores.Application.csproj" />
    <ProjectReference Include="..\GestaoColaboradores.Infrastructure\GestaoColaboradores.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Geracao nativa do documento OpenAPI (.NET 9+). Substitui o
         Swashbuckle, que saiu dos templates do ASP.NET Core no .NET 9. -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <!-- Necessario para o "dotnet ef" usar este projeto como startup.
         PrivateAssets=all impede que vaze como dependencia transitiva. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
