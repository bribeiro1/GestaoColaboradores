<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gestão de Colaboradores</title>

    @* Bibliotecas locais (LibMan) com fallback para CDN: ambiente corporativo
       atrás de proxy costuma não ter saída para internet. *@
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css"
          asp-fallback-href="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/css/bootstrap.min.css"
          asp-fallback-test-class="visually-hidden"
          asp-fallback-test-property="position"
          asp-fallback-test-value="absolute" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css"
          asp-fallback-href="https://cdn.jsdelivr.net/npm/bootstrap-icons@@1.11.3/font/bootstrap-icons.min.css"
          asp-fallback-test-class="bi"
          asp-fallback-test-property="font-family"
          asp-fallback-test-value="bootstrap-icons" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @* O jQuery.ajax lê este campo e envia o valor no header
       RequestVerificationToken em toda requisição que altera estado. *@
    @Html.AntiForgeryToken()

    <header class="app-header">
        <div class="container">
            <a class="app-brand" asp-controller="Usuarios" asp-action="Index">
                <i class="bi bi-people-fill"></i>
                <span>Gestão de Colaboradores</span>
            </a>
        </div>
    </header>

    <main class="container app-main">
        @RenderBody()
    </main>

    <footer class="app-footer">
        <div class="container">
            ASP.NET Core MVC &middot; Entity Framework Core &middot; SQL Server &middot; jQuery
        </div>
    </footer>

    @* Container global de notificações. Preenchido por app.toast(). *@
    <div class="toast-container position-fixed bottom-0 end-0 p-3" id="areaToasts"></div>

    <script src="~/lib/jquery/jquery.min.js"
            asp-fallback-src="https://cdn.jsdelivr.net/npm/jquery@@3.7.1/dist/jquery.min.js"
            asp-fallback-test="window.jQuery"></script>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"
            asp-fallback-src="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/js/bootstrap.bundle.min.js"
            asp-fallback-test="window.bootstrap"></script>
    <script src="~/js/app.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
